# Required core services
FRED_API_KEY=
DATABASE_URL=
APP_USERNAME=
APP_PASSWORD=
CRON_SECRET=

# Optional market-data free tiers. Providers remain disabled when absent.
AWESOMEAPI_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
TIINGO_API_KEY=
ALPACA_API_KEY_ID=
