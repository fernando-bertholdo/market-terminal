FRED_API_KEY=

# Neon Postgres. Leave empty for local file persistence.
DATABASE_URL=

# Required in production. Browser prompts once and stores the session.
APP_USERNAME=
APP_PASSWORD=

# Shared only with the Cloudflare Worker. Use a long random value.
CRON_SECRET=

# Python quant/model engine. Use http://127.0.0.1:8010 for local development.
MODEL_ENGINE_URL=
MODEL_ENGINE_TOKEN=
MODEL_ENGINE_TIMEOUT_MS=8000
MODEL_ENGINE_REQUIRED=false
