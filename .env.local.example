FRED_API_KEY=

# Neon Postgres. Leave empty for local file persistence.
DATABASE_URL=

# Required in production. Browser prompts once and stores the session.
APP_USERNAME=
APP_PASSWORD=

# Shared only with the Cloudflare Worker. Use a long random value.
CRON_SECRET=

# Python backend. Use http://127.0.0.1:8010 for local development.
ATLAS_BACKEND_URL=
ATLAS_BACKEND_TOKEN=
ATLAS_BACKEND_TIMEOUT_MS=8000
ATLAS_BACKEND_REQUIRED=false

# Backward-compatible aliases for the quant engine migration.
MODEL_ENGINE_URL=
MODEL_ENGINE_TOKEN=
MODEL_ENGINE_TIMEOUT_MS=8000
MODEL_ENGINE_REQUIRED=false
