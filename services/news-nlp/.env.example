# news-nlp service config (all optional; defaults shown)
MT_MODEL=Helsinki-NLP/opus-mt-mul-en
FINBERT_MODEL=ProsusAI/finbert
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
ABSA_MODEL=yangheng/deberta-v3-base-absa-v1.1
DEVICE=cpu
NLI_THRESHOLD=0.5
MAX_ASPECTS=3
TRANSLATE=true
WARMUP=false
# Shared bearer token; must equal NEWS_NLP_TOKEN on the Next.js side. Empty = open.
NEWS_NLP_TOKEN=
